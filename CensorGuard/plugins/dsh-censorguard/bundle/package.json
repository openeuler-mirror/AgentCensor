{
  "name": "@censorguard/dsh-bundle",
  "version": "0.4.0",
  "description": "Censorguard DSH bundle patch: insert bootstrap/host/client entries into the web profile and gate key entries on censorguardReady",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "censorguard-dsh-install": "./bin/install.mjs",
    "censorguard-dsh-uninstall": "./bin/uninstall.mjs",
    "censorguard-dsh-dump-config": "./bin/dump-config.mjs"
  },
  "scripts": {
    "install-profile": "node ./bin/install.mjs",
    "uninstall-profile": "node ./bin/uninstall.mjs",
    "verify-profile": "node ./bin/dump-config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only"
}
