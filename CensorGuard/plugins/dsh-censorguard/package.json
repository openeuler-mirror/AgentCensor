{
  "name": "@censorguard/dsh-workspace",
  "private": true,
  "version": "0.4.0",
  "description": "Censorguard DSH whole-tree wrapping plugin workspace: runtime/bootstrap/host/client + bundle installer",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./bundle' build",
    "test": "pnpm -r --filter='./packages/*' --filter='./bundle' test",
    "clean": "pnpm -r --filter='./packages/*' --filter='./bundle' clean"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "license": "GPL-2.0-only"
}
