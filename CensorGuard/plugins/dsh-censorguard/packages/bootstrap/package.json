{
  "name": "@censorguard/dsh-bootstrap",
  "version": "0.4.0",
  "description": "Censorguard DSH Bootstrap plugin: attach_self on startup, provides the censorguardReady service gate",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/censorguardReady.d.ts",
      "import": "./dist/censorguardReady.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@censorguard/dsh-runtime": "file:../runtime"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only"
}
