{
  "name": "@censorguard/dsh-host",
  "version": "0.4.0",
  "description": "Censorguard DSH Host plugin: gRPC bridge + dual RPC channels (/censorguard-read, /censorguard-admin) + bounded audit stream cache",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13",
    "@censorguard/dsh-runtime": "file:../runtime"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only"
}
