{
  "name": "@censorguard/dsh-client",
  "version": "0.4.0",
  "description": "Censorguard DSH Client plugin: security settings section + YAML policy editor + audit conversation tab (browser half)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "lib/client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bash scripts/build-client.sh",
    "test": "node --test dist/**/*.test.js",
    "clean": "rm -rf dist lib"
  },
  "dependencies": {
    "@censorguard/dsh-runtime": "file:../runtime"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only"
}
