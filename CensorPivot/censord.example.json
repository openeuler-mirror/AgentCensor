{
  "state_dir": "/var/lib/agentcensor/censord",
  "startup_timeout_ms": 30000,
  "shutdown_timeout_ms": 10000,
  "poll_interval_ms": 50,
  "command_output_bytes": 262144,
  "censorfs": {
    "daemon": "/usr/libexec/censorfs/censorfsd",
    "control": "/usr/libexec/censorfs/censorfsctl",
    "storage_root": "/var/lib/censorfs/.censorfs",
    "import_root": "/var/lib/agentcensor/workspace",
    "socket": "/run/censorfs/control.sock",
    "branch": "main"
  },
  "censorguard": {
    "config": "/etc/censorguard/agentcensor.yaml",
    "control": "/usr/bin/censorguardctl",
    "daemon": "/usr/sbin/censorguardd"
  },
  "censorscope": {
    "daemon": "/usr/sbin/censorscoped",
    "control": "/usr/bin/censorscopectl",
    "config": "/etc/censorscope/censorscoped.conf",
    "socket": "/run/censorscope/censorscoped.sock",
    "level": "L3",
    "extra_args": []
  }
}
