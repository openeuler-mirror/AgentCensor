[Unit]
Description=CensorPivot ingress and transaction coordinator
Documentation=file:/usr/share/doc/censorpivot/INSTALL.zh-CN.md
Requires=agentcensord.service
After=agentcensord.service

[Service]
Type=simple
User=censorpivot
Group=censorpivot
UMask=0007
RuntimeDirectory=censorpivot
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/censorpivot serve --config /etc/censorpivot/config.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
