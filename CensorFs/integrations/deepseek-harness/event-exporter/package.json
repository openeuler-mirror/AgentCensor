{
  "name": "@censorfs/event-exporter",
  "version": "0.2.0",
  "description": "Child-side DSH plugin: stream session/event over a Unix socket and receive reverse control for CensorFS Parallel Worlds (targets dsh 0.1.5-rc.2)",
  "type": "module",
  "main": "src/index.js",
  "files": ["src/", "cordis.patch.yml"],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/cloudyyy1234/BranchorFS.git",
    "directory": "integrations/deepseek-harness/event-exporter"
  },
  "keywords": ["deepseek", "harness", "censorfs", "events", "agent"],
  "engines": { "node": ">=22.0.0" },
  "author": "CensorFS Contributors",
  "license": "MulanPSL-2.0",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  }
}
