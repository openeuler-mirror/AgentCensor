{
  "name": "@censorfs/deepseek-harness",
  "version": "0.2.0",
  "description": "CensorFS Parallel Worlds runtime and UI bundle with full FUSE child Harness and in-process Namespace Runner modes (targets dsh 0.1.5-rc.2)",
  "type": "module",
  "main": "src/index.js",
  "files": ["src/", "client/", "cordis.patch.yml", "bin/"],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/cloudyyy1234/BranchorFS.git",
    "directory": "integrations/deepseek-harness"
  },
  "keywords": ["deepseek", "harness", "censorfs", "agent", "sandbox", "fuse"],
  "engines": { "node": ">=22.0.0" },
  "author": "CensorFS Contributors",
  "license": "Apache-2.0",
  "exports": {
    ".": { "default": "./src/index.js" },
    "./client": { "default": "./client/index.js" },
    "./events": { "default": "./src/events.js" },
    "./censorfs-cli": { "default": "./src/censorfs-cli.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": { "test": "node --test" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "0.1.5-rc.2",
    "react": "^18.2.0"
  }
}
