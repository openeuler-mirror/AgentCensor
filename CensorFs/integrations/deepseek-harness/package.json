{
  "name": "@censorfs/deepseek-harness",
  "version": "0.2.2",
  "description": "CensorFS Parallel Worlds runtime and UI bundle for dsh 0.2.1-rc.2 with workspace materialization",
  "type": "module",
  "main": "src/index.js",
  "bin": { "dsh-jsonrpc-agent": "./bin/dsh-jsonrpc-agent" },
  "files": ["src/", "client/", "cordis.patch.yml", "bin/"],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/cloudyyy1234/BranchorFS.git",
    "directory": "integrations/deepseek-harness"
  },
  "keywords": ["deepseek", "harness", "censorfs", "agent", "sandbox", "fuse"],
  "engines": { "node": ">=22.0.0", "dsh": "0.2.1-rc.2" },
  "author": "CensorFS Contributors",
  "license": "MulanPSL-2.0",
  "exports": {
    ".": { "default": "./src/index.js" },
    "./client": { "default": "./client/index.js" },
    "./events": { "default": "./src/events.js" },
    "./censorfs-cli": { "default": "./src/censorfs-cli.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": { "test": "node --test" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "react": "^18.2.0"
  }
}
